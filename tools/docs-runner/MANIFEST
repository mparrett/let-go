REPO monk-io-letgo
LOAD template.yaml

# Four environments. `dry` is listed first deliberately: the first environment
# is the one a plain deploy selects, so the default stays the credential-free
# run. `prod` is the only one that pushes, and the two measurement environments
# are last for the same reason `eval` always was - neither must ever be what
# someone gets by accident.
ENV dry prod eval attractor
ENTRY dry:monk-io-letgo/docs-runner-dry
ENTRY prod:monk-io-letgo/docs-runner-prod
ENTRY eval:monk-io-letgo/docs-runner-eval
# The same job with the generation step replaced by an agentic pipeline; dry-run
# only, and never handed the GitHub token. See template.yaml for why it inherits
# the Anthropic layer where `eval` deliberately does not.
ENTRY attractor:monk-io-letgo/docs-runner-attractor
# The same entrypoint again in the bare form. Redundant to the deploy path,
# which reads the scoped lines above fine, but not to the CI generator:
# `cicd_setup` parses only `ENTRY <runnable>` and refuses a project that states
# its entrypoints per environment, with the misleading "MANIFEST has no ENTRY
# directive". Measured 2026-09-12; see the devlog of that date.
#
# It names the DRY entrypoint on purpose, and must keep agreeing with the
# ENV-first default above: whether a bare ENTRY displaces that default is
# undetermined, and the failure mode if it does is a plain deploy that pushes to
# the wiki. Agreeing with the default makes the question harmless. The generated
# workflow names docs-runner-prod explicitly instead.
ENTRY monk-io-letgo/docs-runner-dry

# User-supplied credentials. Nothing here is generated by an entity, so both
# must be collected before the first run.
#
# SECRET takes a flat list of names and cannot be scoped per environment: an
# environment selection reaches ENTRY and IMAGE and nothing else. So the GitHub
# token is still collected ahead of a dry run even though nothing in that run
# can read it - docs-runner-dry neither permits the secret nor places it in the
# container environment. Injection is scoped; collection is not.
SECRET anthropic-api-key docs-runner-github-token
#
# `openrouter-api-key` is deliberately NOT listed. Adding it here would make
# Monk collect it before every dry run too, and the eval path is an occasional
# human-driven experiment, not something CI deploys. Instead it is stored once,
# out of band, scoped to the one runnable that reads it:
#
#   monk secrets add -r monk-io-letgo/docs-runner-eval openrouter-api-key='sk-or-...'
#
# The secret resolves through the same secret("...") call, so it is a real
# source - just not an agent-collected one. This is the only shape found that
# scopes collection, not merely injection.
#
# Scoping the secret to the runnable stores it; it does not grant access to it.
# docs-runner-eval still needs its `permitted-secrets: openrouter-api-key` entry
# in template.yaml, and removing that entry breaks every eval deploy. Read the
# comment there before touching either half.

# tag, runnables that consume it, build context, dockerfile (relative to context).
# The context is `.` because the MANIFEST sits in the same directory as the
# Dockerfile and the sources it COPYs. Monk resolves it relative to this
# MANIFEST, not to the git repository root two levels up.
IMAGE docs-runner monk-io-letgo/docs-runner,monk-io-letgo/docs-runner-anthropic,monk-io-letgo/docs-runner-dry,monk-io-letgo/docs-runner-prod,monk-io-letgo/docs-runner-eval,monk-io-letgo/docs-runner-attractor . Dockerfile
