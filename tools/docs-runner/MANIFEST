REPO monk-io-letgo
LOAD template.yaml

# Three environments. `dry` is listed first deliberately: the first environment
# is the one a plain deploy selects, so the default stays the credential-free
# run. `eval` is last for the same reason - it must never be what someone gets
# by accident.
ENV dry prod eval
ENTRY dry:monk-io-letgo/docs-runner-dry
ENTRY prod:monk-io-letgo/docs-runner-prod
ENTRY eval:monk-io-letgo/docs-runner-eval

# User-supplied credentials. Nothing here is generated by an entity, so both
# must be collected before the first run.
#
# SECRET takes a flat list of names and cannot be scoped per environment: an
# environment selection reaches ENTRY and IMAGE and nothing else. So the GitHub
# token is still collected ahead of a dry run even though nothing in that run
# can read it - docs-runner-dry neither permits the secret nor places it in the
# container environment. Injection is scoped; collection is not.
SECRET anthropic-api-key docs-runner-github-token
#
# `openrouter-api-key` is deliberately NOT listed. Adding it here would make
# Monk collect it before every dry run too, and the eval path is an occasional
# human-driven experiment, not something CI deploys. Instead it is stored once,
# out of band, scoped to the one runnable that reads it:
#
#   monk secrets add -r monk-io-letgo/docs-runner-eval openrouter-api-key='sk-or-...'
#
# A runnable-scoped secret is automatically permitted and resolves through the
# same secret("...") call, so it is a real source - just not an agent-collected
# one. This is the only shape found that scopes collection, not merely injection.

# tag, runnables that consume it, build context, dockerfile (relative to context).
# The context is `.` because the MANIFEST sits in the same directory as the
# Dockerfile and the sources it COPYs. Monk resolves it relative to this
# MANIFEST, not to the git repository root two levels up.
IMAGE docs-runner monk-io-letgo/docs-runner,monk-io-letgo/docs-runner-dry,monk-io-letgo/docs-runner-prod,monk-io-letgo/docs-runner-eval . Dockerfile
